# Documentation only. Copy outside the static document root, then pass
# --env-file /absolute/path/to/the/copied/.env to wrangler dev.
# Workers AI uses the server-side AI binding; no API key is needed.
# Use the Workers Free plan. Do not enable paid plans or AI Gateway billing.
ALLOWED_ORIGIN=http://127.0.0.1:8000
# Optional Web Push configuration (private value goes in a Worker Secret).
# Generate a matching pair using push-setup.html or create-push-keys.mjs.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
NOTIFY_START_HOUR=9
NOTIFY_END_HOUR=21
