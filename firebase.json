{
  "database": {
    "rules": "firebase/database.rules.json"
  },
  "emulators": {
    "database": {
      "port": 9000
    },
    "ui": {
      "enabled": false
    }
  },
  "singleProjectMode": true,
  "functions": [
    {
      "source": "firebase/functions",
      "codebase": "fcm",
      "runtime": "nodejs22",
      "ignore": [
        "node_modules",
        ".git",
        "*.log"
      ]
    }
  ]
}
